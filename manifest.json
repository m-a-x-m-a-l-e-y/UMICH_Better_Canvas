{
  "manifest_version": 3,
  "name": "Michigan +",
  "version": "1.3",
  "permissions": ["storage","activeTab"],
  "host_permissions": [
    "https://maizepages.umich.edu/",
    "https://lvtiodrkrmergoo2cgdao73n2i0sdyuy.lambda-url.us-east-2.on.aws/*" 
  ],
  "icons": {
    "48": "data/48.png",
    "128": "data/128.png"
  },
  "background": {
    "service_worker": "background.bundle.js",
    "type": "module"
    
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Click to open popup",
    "default_icon": "data/48.png"

  },
  "content_scripts": [
    {
      "matches": ["https://umich.instructure.com/"],
      "js": ["eventClass.js", "content.js" , "sportsClass.js"]
    }
  ]
  
}