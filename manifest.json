{
  "manifest_version": 3,
  "name": "Michigan +",
  "version": "1.3",
  "permissions": ["storage","activeTab"],
  "host_permissions": [
    "https://maizepages.umich.edu/",
    "https://lvtiodrkrmergoo2cgdao73n2i0sdyuy.lambda-url.us-east-2.on.aws/*" 
  ],
  "icons": {
    "48": "src/data/48.png",
    "128": "src/data/128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Click to open popup",
    "default_icon": "src/data/48.png"

  },
  "content_scripts": [
    {
      "matches": ["https://umich.instructure.com/"],
      "js": ["src/eventClass.js", "src/content.js" , "src/sportsClass.js"]
    }
  ]
  
}